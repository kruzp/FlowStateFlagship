import * as THREE from 'three';
import { GPGPU, DoubleFBO } from '../GPGPU';

/
 * DyeField owns the double-buffered dye/density texture — the quantity
 * that gets carried along by the velocity field and eventually read by
 * the (future) materials/ layer to produce color. Like VelocityField,
 * this class is intentionally dumb storage; Simulation.ts does the work.
 */
export class DyeField {
  readonly fbo: DoubleFBO;

  constructor(gpgpu: GPGPU, width: number, height: number, type: THREE.TextureDataType) {
    this.fbo = gpgpu.createDoubleFBO(width, height, type);
  }

  get texture(): THREE.Texture {
    return this.fbo.texture;
  }

  swap(): void {
    this.fbo.swap();
  }

  dispose(): void {
    this.fbo.dispose();
  }
}
